rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read and write for the application
    match /system/{docId} {
      allow read, write: if true;
    }

    // User profile
    match /users/{userId} {
      allow read, write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Souvenirs
    match /souvenirs/{souvenirId} {
      allow read, write: if true;
    }

    // Activities
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // Inventory In Transactions
    match /inventoryIn/{inId} {
      allow read, write: if true;
    }

    // Inventory Out Transactions (Header)
    match /inventoryOut/{outId} {
      allow read, write: if true;
    }

    // Inventory Out Items (Detail lines)
    match /inventoryOutItems/{itemId} {
      allow read, write: if true;
    }
  }
}
